# SAVE AS: .env.example
# Copy to .env.local and fill in real values. NEVER commit real secrets.
# Placeholder values only below — none of these will connect to anything.

# PostgreSQL connection string (pooled). Used by Prisma Client at runtime.
# Example for Neon: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_P1lKuIYZHqV3@ep-lingering-mouse-a7uxdjfd-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct (unpooled) PostgreSQL connection. Used by Prisma Migrate.
# On Neon this is the non-pooler host; locally it can match DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/restaurant_pos?sslmode=require"

# Secret used by Better Auth to sign sessions. Use a long random string.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Public base URL of the app, used by Better Auth for callbacks/cookies.
# Local: http://localhost:3000 — Production: https://your-domain.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used to build links (e.g. table QR codes).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Upstash Redis (OPTIONAL). Cache + rate limiting only — the app NEVER
# crashes without Redis; every cache/rate-limit read falls back to
# PostgreSQL / in-memory behaviour. Leave both unset for local dev
# without Redis, or set both for production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
